<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!-- IIS WebDAV answers OPTIONS (CORS preflight) itself, without CORS headers,
           and blocks PUT/DELETE - remove it so every request reaches the API. -->
      <modules runAllManagedModulesForAllRequests="false">
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
        <remove name="OPTIONSVerbHandler" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!--
        Self-contained publish (win-x64): no .NET install needed on the server.
        outofprocess = runs as its own process behind IIS (not affected by the
        Plesk app-pool 32/64-bit setting).
        Logs (all in the site's Logs folder - the IIS app-pool user needs Modify on it):
          platform-api.log / requests.log / errors.log  - log4net, daily files (see log4net.config)
          stdout_*.log - startup crashes and log4net's own errors (e.g. "access denied").
                         In Production the console logger is off, so this file stays small.
      -->
      <aspNetCore processPath=".\RenewalTracker.PlatformApi.exe"
                  arguments=""
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\Logs\stdout"
                  hostingModel="outofprocess"
                  startupTimeLimit="120">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
