<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!-- IIS WebDAV answers OPTIONS (CORS preflight) itself, without CORS headers,
           and blocks PUT/DELETE - remove it so every request reaches the API. -->
      <modules runAllManagedModulesForAllRequests="false">
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
        <remove name="OPTIONSVerbHandler" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!--
        Self-contained publish (win-x64): no .NET install needed on the server.
        outofprocess = runs as its own dotnet process behind IIS (not affected by the
        Plesk app-pool 32/64-bit setting). Turn stdoutLogEnabled on only to debug a 500.30.
      -->
      <aspNetCore processPath=".\RenewalTracker.PlatformApi.exe"
                  arguments=""
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="outofprocess"
                  startupTimeLimit="120">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
