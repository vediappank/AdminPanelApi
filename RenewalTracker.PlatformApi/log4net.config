<?xml version="1.0" encoding="utf-8" ?>
<log4net>

  <!-- One rolling file per day under Logs/, kept for 30 days. This is the
       durable, always-on record: every request/response summary
       (RequestResponseLoggingMiddleware), every warning/error
       (ExceptionHandlingMiddleware, and any controller that logs), all in
       one place you can tail or ship off the box - separate from the
       console output Visual Studio already shows you while debugging. -->
  <appender name="RollingFileAppender" type="log4net.Appender.RollingFileAppender">
    <file value="Logs/platform-api.log" />
    <appendToFile value="true" />
    <rollingStyle value="Date" />
    <datePattern value="'.'yyyyMMdd'.log'" />
    <staticLogFileName value="true" />
    <maxSizeRollBackups value="30" />
    <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date{yyyy-MM-dd HH:mm:ss,fff} [%thread] %-5level %logger - %message%newline%exception" />
    </layout>
  </appender>

  <!-- A second file just for request/response traffic, so "what did this
       endpoint receive/return at 14:32" doesn't have to be grepped out of
       the same file as errors. Fed by RequestResponseLoggingMiddleware's
       ILogger<RequestResponseLoggingMiddleware>. -->
  <appender name="RequestResponseAppender" type="log4net.Appender.RollingFileAppender">
    <file value="Logs/requests.log" />
    <appendToFile value="true" />
    <rollingStyle value="Date" />
    <datePattern value="'.'yyyyMMdd'.log'" />
    <staticLogFileName value="true" />
    <maxSizeRollBackups value="30" />
    <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date{yyyy-MM-dd HH:mm:ss,fff} %message%newline" />
    </layout>
  </appender>

  <root>
    <level value="DEBUG" />
    <appender-ref ref="RollingFileAppender" />
  </root>

  <!-- Route only the request/response middleware's own log lines into
       requests.log (in addition to the shared file above - additivity stays
       on so they still land in platform-api.log too). -->
  <logger name="RenewalTracker.PlatformApi.Middleware.RequestResponseLoggingMiddleware">
    <level value="DEBUG" />
    <appender-ref ref="RequestResponseAppender" />
  </logger>

  <!-- EF Core logs every generated SQL command at Information level, which
       drowns out everything else - keep it at Warning here the same way
       appsettings.json's default console logging already does. -->
  <logger name="Microsoft.EntityFrameworkCore">
    <level value="WARN" />
  </logger>
  <logger name="Microsoft">
    <level value="WARN" />
  </logger>

</log4net>
